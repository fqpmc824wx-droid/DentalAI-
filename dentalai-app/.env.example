# Copy to .env.local and fill in
# Generate a secret: openssl rand -base64 32

AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Auth.js validates Host headers. Enable only for controlled local or deployed hosts.
AUTH_TRUST_HOST=true

# ── Deployment environment (S019) ─────────────────────────────────────────
# Explicit label: development | staging | production
# When unset, derived from NODE_ENV (production → production, else development).
DENTALAI_APP_ENV=development

# Pin SQLite data directory for staging/production. Tests use in-memory stores.
# Default when unset: <project>/.data/dentalai.db
# DENTALAI_DATA_DIR=/var/lib/dentalai

# ── Dentally (Phase 2 read-only proof) ───────────────────────────────────
# Leave blank to disable Dentally integration entirely. The app reports the
# health status as "not_configured" instead of failing.
#
# When set, both DENTALLY_API_BASE_URL and DENTALLY_API_TOKEN are required.
# Token scopes required (read-only):
#   appointment:read · correspondence:read · financials:read
#   patient:read · practice:read · user:read · treatments
#
# NEVER prefix Dentally vars with NEXT_PUBLIC_ — that would leak the token
# to the browser bundle.
DENTALLY_API_BASE_URL=
DENTALLY_API_TOKEN=

# Optional. Default 8000ms.
DENTALLY_TIMEOUT_MS=
